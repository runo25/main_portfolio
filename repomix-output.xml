/* ===================================================
   ORUNO AWHIE — EDITORIAL BESPOKE PORTFOLIO
   Natural Scandinavian / Editorial Design System
   Inspired by Creative Agency Aesthetics
=================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  /* Canvas & Backgrounds */
  --bg-hero: #E9EFEF;
  --bg-hero-accent: #E0E8E7;
  --bg-page: #FFFFFF;
  --bg-subtle: #F6F9F8;
  --bg-card: #FFFFFF;
  --bg-card-subtle: #F9FBFA;
  --bg-dark-card: #0F1624;
  --bg-dark-surface: #172033;

  /* Text & Hierarchy */
  --text-primary: #0F172A;
  --text-secondary: #475569;
  --text-muted: #64748B;
  --text-light: #F8FAFC;
  --text-light-muted: #94A3B8;

  /* Accents */
  --accent-dark: #0F172A;
  --accent-pine: #0F766E;
  --accent-emerald: #059669;
  --accent-clay: #C2410C;
  --accent-sand: #D97706;

  /* Borders */
  --border-light: rgba(15, 23, 42, 0.08);
  --border-subtle: rgba(15, 23, 42, 0.05);
  --border-dark: rgba(255, 255, 255, 0.1);
  --border-active: #0F172A;

  /* Shadows */
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 10px 25px -4px rgba(15, 23, 42, 0.05), 0 4px 10px -2px rgba(15, 23, 42, 0.02);
  --shadow-lg: 0 20px 40px -8px rgba(15, 23, 42, 0.08), 0 8px 16px -4px rgba(15, 23, 42, 0.03);
  --shadow-dark: 0 24px 48px -12px rgba(0, 0, 0, 0.35);

  /* Typography */
  --font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  /* Layout & Radii */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 32px;
  --radius-full: 9999px;
  --radius-arch: 240px 240px 24px 24px;

  --container-max: 1200px;
  --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reset & Foundation */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  overflow-x: hidden;
}

/* Section scroll-margin to offset sticky navbar */
section, [id] {
  scroll-margin-top: 85px;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

/* Container */
.container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 2rem;
}

/* Typography Helpers */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  color: var(--text-primary);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.section-label {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 0.75rem;
}

.section-title {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.03em;
  line-height: 1.2;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 580px;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1.6rem;
  border-radius: var(--radius-full);
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  transition: all var(--transition-fast);
  border: 1px solid transparent;
  outline: none;
}

.btn-dark {
  background-color: var(--accent-dark);
  color: #FFFFFF;
}

.btn-dark:hover {
  background-color: #1E293B;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.15);
}

.btn-outline {
  background-color: transparent;
  color: var(--text-primary);
  border-color: var(--border-light);
}

.btn-outline:hover {
  background-color: #FFFFFF;
  border-color: var(--text-primary);
  transform: translateY(-2px);
}

.btn-white {
  background-color: #FFFFFF;
  color: var(--text-primary);
  border-color: rgba(0, 0, 0, 0.08);
  box-shadow: var(--shadow-sm);
}

.btn-white:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* Pill Tags */
.pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 1rem;
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.pill-tag:hover {
  border-color: var(--text-primary);
  color: var(--text-primary);
}

.pill-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background-color: var(--text-muted);
}

/* Wavy Accent Line (like reference) */
.wavy-line {
  display: inline-block;
  width: 56px;
  height: 8px;
  background-image: url("data:image/svg+xml,%3Csvg width='56' height='8' viewBox='0 0 56 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4C4 1 7 1 10 4C13 7 16 7 19 4C22 1 25 1 28 4C31 7 34 7 37 4C40 1 43 1 46 4C49 7 52 7 55 4' stroke='%230F172A' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: contain;
  margin-top: 0.25rem;
}

/* Marquee Ticker */
@keyframes ticker-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: ticker-marquee 32s linear infinite;
}

.ticker-track:hover {
  animation-play-state: paused;
}

/* Section Spacing */
.section-pad {
  padding: 6rem 0;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-subtle);
}

::-webkit-scrollbar-thumb {
  background: #CBD5E1;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: #94A3B8;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .section-pad {
    padding: 4.5rem 0;
  }
}

@media (max-width: 768px) {
  .container {
    padding: 0 1.25rem;
  }
  .section-pad {
    padding: 3.5rem 0;
  }
}

@media (max-width: 480px) {
  .container {
    padding: 0 1rem;
  }
  .section-title {
    font-size: 1.85rem;
  }
}
